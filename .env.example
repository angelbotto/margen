# Generate your .env with scripts/configure_portal.py; never commit credentials.
BOTTIFACT_ORIGIN=https://artifacts.example.com
BOTTIFACT_DOMAIN=artifacts.example.com
BOTTIFACT_ADMIN_EMAILS=owner@example.com
# Optional aliases belonging to the SAME owner, canonical email first. Not team members.
BOTTIFACT_OWNER_ALIASES=
BOTTIFACT_AUTH_SECRET=REPLACE_WITH_A_RANDOM_SECRET
BOTTIFACT_DATA=/data
BOTTIFACT_BACKUPS=/backups
BOTTIFACT_RELEASES=/releases
BOTTIFACT_BIND=127.0.0.1
BOTTIFACT_PORT=8788
BOTTIFACT_UID=1000
BOTTIFACT_GID=1000
# Native Google OIDC. Register ORIGIN/auth/google/callback in your Google project.
BOTTIFACT_GOOGLE_ENABLED=0
BOTTIFACT_GOOGLE_ID=
BOTTIFACT_GOOGLE_SECRET=
# Optional passwordless email: resend or usesend (UseSend can be self-hosted).
BOTTIFACT_EMAIL_PROVIDER=usesend
BOTTIFACT_EMAIL_URL=
BOTTIFACT_EMAIL_FROM=
BOTTIFACT_EMAIL_KEY=
# No Cloudflare account, botto.is account or managed database is required.

# Per-owner library quota; SQLite remains a single-instance service.
MARGEN_MAX_ARTIFACTS=10000

# Optional owner-enabled audience measurement; independent from authentication.
# See docs/analytics.md. Do not put Umami admin credentials here.
MARGEN_UMAMI_URL=
MARGEN_UMAMI_WEBSITE_ID=
MARGEN_ANALYTICS_ENABLED=0
# Optional server-only Umami reporting for per-artifact reader activity.
# Choose ONE credential method; never expose these in artifact HTML.
MARGEN_UMAMI_API_VERSION=3
MARGEN_UMAMI_API_ORIGIN=
MARGEN_UMAMI_SHARE_ID=
MARGEN_UMAMI_TOKEN=
MARGEN_UMAMI_USERNAME=
MARGEN_UMAMI_PASSWORD=

# Neural narration: OFF until an operator selects a provider, approves budget,
# checks retention/stock voices and completes the auditory gate in docs/neural-narration.md.
# Dedicated server secret only. No automatic use of other API credentials.
MARGEN_NARRATION_ENABLED=0
MARGEN_NARRATION_BILLING_APPROVED=0
MARGEN_NARRATION_PROVIDER=
MARGEN_NARRATION_KEY=
MARGEN_NARRATION_AZURE_REGION=
MARGEN_NARRATION_MODEL=
MARGEN_NARRATION_VOICES=[]
# Required positive limits: global/user characters per UTC day and conservative cost reserve.
# MICRO_USD is millionths of USD; zero disables activation. Set approved upper-bound unit price.
MARGEN_NARRATION_DAILY_CHARS=0
MARGEN_NARRATION_USER_CHARS=0
MARGEN_NARRATION_DAILY_MICRO_USD=0
MARGEN_NARRATION_USD_PER_MILLION_CHARS=0
