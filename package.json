{
  "name": "bottifact-workspace",
  "private": true,
  "version": "0.12.0",
  "workspaces": [
    "packages/core",
    "packages/react"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "node scripts/build_table_model.mjs && python3 scripts/build_core.py && npm run build -w @bottifact/core && npm run build -w @bottifact/react",
    "test": "vitest run",
    "typecheck": "tsc -p packages/react/tsconfig.json --noEmit",
    "dev": "vite --host 127.0.0.1",
    "build:demo": "vite build",
    "check": "npm run build && npm run typecheck && npm test"
  },
  "devDependencies": {
    "@testing-library/react": "16.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "jsdom": "30.1.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "vitest": "5.0.1"
  },
  "type": "module"
}
